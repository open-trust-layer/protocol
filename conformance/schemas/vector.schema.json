{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:olp:conformance:schema:vector:v1",
  "type": "object",
  "required": ["schema", "id", "capability", "category", "operation", "input", "expected"],
  "properties": {
    "schema": {"const": "olp-conformance-vector-v1"},
    "id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "minLength": 1},
    "category": {"enum": ["positive", "negative", "malformed", "unsupported"]},
    "operation": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "input": {"type": "object"},
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {"outcome": {"enum": ["SUCCESS", "ERROR"]}}
    }
  }
}
