{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:olp:conformance:schema:manifest:v1",
  "type": "object",
  "required": ["schema", "version", "harness_version", "profiles", "cases"],
  "properties": {
    "schema": {"const": "olp-conformance-manifest-v1"},
    "version": {"const": 1},
    "harness_version": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "capability", "category", "operation", "vector"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "category": {"enum": ["positive", "negative", "malformed", "unsupported"]},
          "operation": {"type": "string", "minLength": 1},
          "vector": {"type": "string", "minLength": 1},
          "description": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
