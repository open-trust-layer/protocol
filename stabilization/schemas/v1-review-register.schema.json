{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:olp:stabilization:schema:v1-review-register:v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "baseline_release",
    "baseline_commit",
    "review_scope",
    "findings"
  ],
  "properties": {
    "schema": {"const": "olp-v1-review-register-v1"},
    "version": {"const": 1},
    "baseline_release": {"type": "string", "minLength": 1},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "review_scope": {
      "type": "object",
      "required": ["specifications", "cross_cutting"],
      "properties": {
        "specifications": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9]{4}$"},
          "uniqueItems": true
        },
        "cross_cutting": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "severity", "status", "summary", "resolution"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "class": {"type": "string", "minLength": 1},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "status": {"enum": ["open", "resolved"]},
          "summary": {"type": "string", "minLength": 1},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
