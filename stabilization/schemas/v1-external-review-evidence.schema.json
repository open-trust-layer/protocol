{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-trust-layer.org/schemas/olp-external-review-evidence-v1.json",
  "title": "OLP external review evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "gate",
    "review_target",
    "reviewer",
    "methodology",
    "scope",
    "findings",
    "excluded_areas",
    "residual_risks",
    "references",
    "completed"
  ],
  "properties": {
    "schema": {"const": "olp-external-review-evidence-v1"},
    "version": {"const": 1},
    "gate": {
      "enum": ["public_technical_review", "independent_external_security_review"]
    },
    "review_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_commit"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "organization", "independence_statement"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "organization": {"type": "string", "minLength": 1, "maxLength": 256},
        "independence_statement": {"type": "string", "maxLength": 2000}
      }
    },
    "methodology": {"$ref": "#/$defs/nonEmptyTextList"},
    "scope": {"$ref": "#/$defs/nonEmptyTextList"},
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "summary", "disposition"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "severity": {"enum": ["informational", "low", "medium", "high", "critical"]},
          "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
          "disposition": {"enum": ["resolved", "accepted-residual-risk", "not-applicable"]}
        }
      }
    },
    "excluded_areas": {"$ref": "#/$defs/textList"},
    "residual_risks": {"$ref": "#/$defs/textList"},
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    },
    "completed": {"const": true}
  },
  "$defs": {
    "nonEmptyTextList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    },
    "textList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 4000}
    }
  }
}
