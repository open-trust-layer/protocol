# OLP conformance and promotion commitments hash exact repository file bytes.
# Force deterministic LF working-tree bytes for textual files on every platform,
# including Git for Windows installations configured with core.autocrlf=true.
* text=auto eol=lf

# Common binary artifacts must never undergo text conversion.
*.bin -text
*.cbor -text
*.der -text
*.gif -text
*.gz -text
*.ico -text
*.jpeg -text
*.jpg -text
*.pdf -text
*.png -text
*.tar -text
*.webp -text
*.zip -text
